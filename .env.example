# 复制为项目根目录 .env.local；只填自己的密钥。环境变量优先于此文件。
# 密钥仅由 Python 后端读取，不能填入 Unity、WebGL 或浏览器脚本。

# 小禾对话、需求拆分、布局建议与视觉检查（默认 qwen3.8-flash）。
QWEN_AGENT_API_KEY=

# 家园概念图、资产设计图：LiveTools 使用 gpt-image-2。
TOAPIS_API_KEY=
TOAPIS_BASE_URL=https://toapis.cn

# 阿何洛图生 3D：国内账号 cn，国际账号 com。
AHOLO_API_KEY=
AHOLO_REGION=cn
AHOLO_MODEL=G1
AHOLO_MODEL_PRICE_CREDITS=1

# 旧版物件设计工作台的可选 Qwen 生图接口；非 WebGL 主流程必需。
# 未填 QWEN_AGENT_API_KEY 时，Agent 会回退使用 QWEN_API_KEY。
QWEN_API_KEY=
QWEN_API_URL=https://maas.qianwenaiapi.com/compatible-mode/v1/images/generations
QWEN_MODEL=qwen-image-3.0
QWEN_INPUT_IMAGE_PRICE_CNY=0.02
QWEN_OUTPUT_IMAGE_PRICE_CNY=0.18
